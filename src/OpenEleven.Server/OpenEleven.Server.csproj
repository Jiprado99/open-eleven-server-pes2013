<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Shared core library: each title ships as its own slim exe under src/OpenEleven.*. -->
    <OutputType>Library</OutputType>
    <RootNamespace>OpenEleven.Server</RootNamespace>
    <UserSecretsId>OpenEleven</UserSecretsId>
    <!-- wwwroot here is the whole site's static content for every title exe, not a
         reusable component library, so serve it at the root instead of namespaced
         under /_content/OpenEleven.Server/. -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Log redaction and packet formatting are transport internals; the suite has to be
         able to assert that a credential never reaches a log line. -->
    <InternalsVisibleTo Include="OpenEleven.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The PES 2013 helper scripts live in the repository's tools folder and are offered on the
         site's /tools page. Served by a fixed-name endpoint from <app>/tools, so the page can only
         ever hand out these files. -->
    <None Include="..\..\tools\run-pes2013-radmin.ps1" Link="tools\run-pes2013-radmin.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\tools\run-pes2013-radmin.bat" Link="tools\run-pes2013-radmin.bat" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenEleven.Protocol\OpenEleven.Protocol.csproj" />
    <ProjectReference Include="..\OpenEleven.Data\OpenEleven.Data.csproj" />
  </ItemGroup>

</Project>
